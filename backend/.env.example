# Copy to a real environment (shell export, systemd unit, container env).
# NEVER commit a real password or secret.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ---------------------------------------------------------------- database ---
# Local development uses H2, started in process. Nothing here needs setting for
# `mvn spring-boot:run` to work - these are the defaults, shown so they can be
# overridden.
DB_URL=jdbc:h2:file:./data/itsm;MODE=PostgreSQL;DB_CLOSE_ON_EXIT=FALSE
DB_USERNAME=sa
DB_PASSWORD=
DB_DDL_AUTO=update
H2_CONSOLE=true

# PostgreSQL is opt in, with: mvn spring-boot:run -Dspring-boot.run.profiles=postgres
# Under that profile Flyway owns the schema and Hibernate validates it.
# DB_URL=jdbc:postgresql://localhost:5432/itsm
# DB_USERNAME=itsm
# DB_PASSWORD=replace-me
# DB_DDL_AUTO=validate
# FLYWAY_ENABLED=true

# ------------------------------------------------------------------- auth ---
# Must be at least 32 characters. Generate per environment; never commit a real one.
JWT_SECRET=replace-me-with-a-32-character-minimum-secret
JWT_ACCESS_TTL_MINUTES=60

# --------------------------------------------------------------- sla sweep ---
SLA_SCHEDULER_ENABLED=true
SLA_SCHEDULER_INTERVAL_MS=60000
SLA_SCHEDULER_INITIAL_DELAY_MS=15000

# ------------------------------------------------------------ redis cache ---
# Deployed: CACHE_TYPE=redis (the default). The dev profile uses an in-memory
# cache, so none of this is needed locally.
# CACHE_TYPE=redis
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_SSL_ENABLED=false
# REDIS_TIMEOUT=2s
# REDIS_CONNECT_TIMEOUT=2s
# CACHE_TTL=10m
# REDIS_HEALTH_ENABLED=true

# ------------------------------------------------------------- attachments ---
# Deployed: ATTACHMENT_STORAGE=s3 (the default). The dev profile stores files in
# ./data/attachments instead. AWS credentials are NOT configured here: the S3
# client uses the default provider chain (the EC2 instance role when deployed).
# ATTACHMENT_STORAGE=s3
# S3_BUCKET_NAME=resolvex-itsm-attachments
# AWS_REGION=ap-south-1
# S3_KEY_PREFIX=incidents/
# ATTACHMENT_MAX_FILE_SIZE=10MB
# ATTACHMENT_MAX_REQUEST_SIZE=11MB
# ATTACHMENT_LOCAL_DIR=./data/attachments

# ------------------------------------------------------------------- other ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# Logs every SQL statement. Development only.
SHOW_SQL=false
